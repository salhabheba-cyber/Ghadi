{
  "name": "ghadi-ai",
  "version": "0.1.0",
  "description": "Free, open-source, local-first study platform: turn documents into notes, quizzes and spaced-repetition flashcards.",
  "keywords": [
    "study",
    "flashcards",
    "spaced-repetition",
    "quiz",
    "local-first",
    "nextjs",
    "indexeddb",
    "education"
  ],
  "license": "MIT",
  "homepage": "https://github.com/salhabheba-cyber/Ghadi#readme",
  "bugs": {
    "url": "https://github.com/salhabheba-cyber/Ghadi/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "predev": "npm run ocr:assets",
    "prebuild": "npm run ocr:assets"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "docx": "^9.13.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.60.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.2",
    "openai": "^7.39.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}

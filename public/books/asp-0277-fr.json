5.jpg","alt":""},{"t":"p","x":"Viens nager avec nous."}]},{"id":"p15","title":"","blocks":[{"t":"img","src":"/books/img/0277/16.jpg","alt":""},{"t":"p","x":"Viens jouer à cachecache avec nous."}]},{"id":"p16","title":"","blocks":[{"t":"img","src":"/books/img/0277/17.jpg","alt":""},{"t":"p","x":"Viens lire avec nous."}]}]}
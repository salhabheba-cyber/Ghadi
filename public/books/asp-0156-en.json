{"v":1,"lang":"en","dir":"ltr","layout":"pages","chapters":[{"id":"cover","title":"The hungry crocodile","blocks":[{"t":"img","src":"/books/img/0156/01.jpg","alt":""},{"t":"h","x":"The hungry crocodile"}]},{"id":"p1","title":"","blocks":[{"t":"img","src":"/books/img/0156/02.jpg","alt":""},{"t":"p","x":"Once there was a very hungry crocodile."}]},{"id":"p2","title":"","blocks":[{"t":"img","src":"/books/img/0156/03.jpg","alt":""},{"t":"p","x":"He searched for food slowly and quietly. And then..."}]},{"id":"p3","title":"","blocks":[{"t":"img","src":"/books/img/0156/04.jpg","alt":""},{"t":"p","x":"POW!!! The crocodile strikes!"}]},{"id":"p4","title":"","blocks":[{"t":"img","src":"/books/img/0156/05.jpg","alt":""},{"t":"p","x":"After that he is no longer hungry, and he is happy."}]},{"id":"p5","title":"","blocks":[{"t":"img","src":"/books/img/0156/06.jpg","alt":""},{"t":"p","x":"Until he gets hungry again."}]}]}
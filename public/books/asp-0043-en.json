{"v":1,"lang":"en","dir":"ltr","layout":"pages","chapters":[{"id":"cover","title":"Fire's story","blocks":[{"t":"img","src":"/books/img/0043/01.jpg","alt":""},{"t":"h","x":"Fire's story"}]},{"id":"p1","title":"","blocks":[{"t":"img","src":"/books/img/0043/02.jpg","alt":""},{"t":"p","x":"Let me tell you my story. I start as a small spark."}]},{"id":"p2","title":"","blocks":[{"t":"img","src":"/books/img/0043/03.jpg","alt":""},{"t":"p","x":"I run wild when the wind carries me."}]},{"id":"p3","title":"","blocks":[{"t":"img","src":"/books/img/0043/04.jpg","alt":""},{"t":"p","x":"We are good friends, you and I."}]},{"id":"p4","title":"","blocks":[{"t":"img","src":"/books/img/0043/05.jpg","alt":""},{"t":"p","x":"I cook your food."}]},{"id":"p5","title":"","blocks":[{"t":"img","src":"/books/img/0043/06.jpg","alt":""},{"t":"p","x":"I light your night."}]},{"id":"p6","title":"","blocks":[{"t":"img","src":"/books/img/0043/07.jpg","alt":""},{"t":"p","x":"I have many tricks."}]},{"id":"p7","title":"","blocks":[{"t":"img","src":"/books/img/0043/08.jpg","alt":""},{"t":"p","x":"I am part of your family."}]},{"id":"p8","title":"","blocks":[{"t":"img","src":"/books/img/0043/09.jpg","alt":""},{"t":"p","x":"But be careful when you invite me to your home. I don't like to be left alone."}]}]}
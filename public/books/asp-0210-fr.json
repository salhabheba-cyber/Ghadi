{"v":1,"lang":"fr","dir":"ltr","layout":"pages","chapters":[{"id":"cover","title":"Tingi et les vaches","blocks":[{"t":"img","src":"/books/img/0210/01.jpg","alt":""},{"t":"h","x":"Tingi et les vaches"}]},{"id":"p1","title":"","blocks":[{"t":"img","src":"/books/img/0210/02.jpg","alt":""},{"t":"p","x":"Tingi vivait avec sa grand-mère."}]},{"id":"p2","title":"","blocks":[{"t":"img","src":"/books/img/0210/03.jpg","alt":""},{"t":"p","x":"Il gardait les vaches avec elle."}]},{"id":"p3","title":"","blocks":[{"t":"img","src":"/books/img/0210/04.jpg","alt":""},{"t":"p","x":"Un jour, des soldats arrivèrent."}]},{"id":"p4","title":"","blocks":[{"t":"img","src":"/books/img/0210/05.jpg","alt":""},{"t":"p","x":"Ils emmenèrent les vaches."}]},{"id":"p5","title":"","blocks":[{"t":"img","src":"/books/img/0210/06.jpg","alt":""},{"t":"p","x":"Tingi et sa grand-mère se sauvèrent et se cachèrent."}]},{"id":"p6","title":"","blocks":[{"t":"img","src":"/books/img/0210/07.jpg","alt":""},{"t":"p","x":"Ils restèrent cachés dans des buissons jusqu'au soir."}]},{"id":"p7","title":"","blocks":[{"t":"img","src":"/books/img/0210/08.jpg","alt":""},{"t":"p","x":"Puis les soldats revinrent."}]},{"id":"p8","title":"","blocks":[{"t":"img","src":"/books/img/0210/09.jpg","alt":""},{"t":"p","x":"La grand-mère de Tingi recouvrit alors leurs corps de feuilles."}]},{"id":"p9","title":"","blocks":[{"t":"img","src":"/books/img/0210/10.jpg","alt":""},{"t":"p","x":"Un des soldats marcha sur Tingi, mais celui-ci ne réagit pas."}]},{"id":"p10","title":"","blocks":[{"t":"img","src":"/books/img/0210/11.jpg","alt":""},{"t":"p","x":"Quand il n'y eut plus de danger, Tingi et sa grand-mère se relevèrent."}]},{"id":"p11","title":"","blocks":[{"t":"img","src":"/books/img/0210/12.jpg","alt":""},{"t":"p","x":"Ils revinrent chez eux sans faire le moindre bruit."}]}]}
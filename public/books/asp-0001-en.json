{"v":1,"lang":"en","dir":"ltr","layout":"pages","chapters":[{"id":"cover","title":"A very tall man","blocks":[{"t":"img","src":"/books/img/0001/01.jpg","alt":""},{"t":"h","x":"A very tall man"}]},{"id":"p1","title":"","blocks":[{"t":"img","src":"/books/img/0001/02.jpg","alt":""},{"t":"p","x":"His hoe was too short."}]},{"id":"p2","title":"","blocks":[{"t":"img","src":"/books/img/0001/03.jpg","alt":""},{"t":"p","x":"His doorway was too low."}]},{"id":"p3","title":"","blocks":[{"t":"img","src":"/books/img/0001/04.jpg","alt":""},{"t":"p","x":"His bed was too short."}]},{"id":"p4","title":"","blocks":[{"t":"img","src":"/books/img/0001/05.jpg","alt":""},{"t":"p","x":"His bicycle was too short."}]},{"id":"p5","title":"","blocks":[{"t":"img","src":"/books/img/0001/06.jpg","alt":""},{"t":"p","x":"This man was too tall!"}]},{"id":"p6","title":"","blocks":[{"t":"img","src":"/books/img/0001/07.jpg","alt":""},{"t":"p","x":"He made a very long hoe handle."}]},{"id":"p7","title":"","blocks":[{"t":"img","src":"/books/img/0001/08.jpg","alt":""},{"t":"p","x":"He made very high door frames."}]},{"id":"p8","title":"","blocks":[{"t":"img","src":"/books/img/0001/09.jpg","alt":""},{"t":"p","x":"He made a very long bed."}]},{"id":"p9","title":"","blocks":[{"t":"img","src":"/books/img/0001/10.jpg","alt":""},{"t":"p","x":"He bought a very high bicycle."}]},{"id":"p10","title":"","blocks":[{"t":"img","src":"/books/img/0001/11.jpg","alt":""},{"t":"p","x":"He sat on a very high chair. He ate with a very long fork."}]},{"id":"p11","title":"","blocks":[{"t":"img","src":"/books/img/0001/12.jpg","alt":""},{"t":"p","x":"He left his house and lived in a big forest. He lived for many years."}]}]}
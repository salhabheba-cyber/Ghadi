{"v":1,"lang":"fr","dir":"ltr","layout":"pages","chapters":[{"id":"cover","title":"Un homme très grand","blocks":[{"t":"img","src":"/books/img/0001/01.jpg","alt":""},{"t":"h","x":"Un homme très grand"}]},{"id":"p1","title":"","blocks":[{"t":"img","src":"/books/img/0001/02.jpg","alt":""},{"t":"p","x":"Sa houe était trop courte."}]},{"id":"p2","title":"","blocks":[{"t":"img","src":"/books/img/0001/03.jpg","alt":""},{"t":"p","x":"Sa porte d'entrée était trop basse."}]},{"id":"p3","title":"","blocks":[{"t":"img","src":"/books/img/0001/04.jpg","alt":""},{"t":"p","x":"Son lit était trop court."}]},{"id":"p4","title":"","blocks":[{"t":"img","src":"/books/img/0001/05.jpg","alt":""},{"t":"p","x":"Sa bicyclette était trop petite."}]},{"id":"p5","title":"","blocks":[{"t":"img","src":"/books/img/0001/06.jpg","alt":""},{"t":"p","x":"Cet homme était trop grand."}]},{"id":"p6","title":"","blocks":[{"t":"img","src":"/books/img/0001/07.jpg","alt":""},{"t":"p","x":"Il fabriqua un long manche pour sa houe."}]},{"id":"p7","title":"","blocks":[{"t":"img","src":"/books/img/0001/08.jpg","alt":""},{"t":"p","x":"Il agrandit ses portes."}]},{"id":"p8","title":"","blocks":[{"t":"img","src":"/books/img/0001/09.jpg","alt":""},{"t":"p","x":"Il fabriqua un très grand lit."}]},{"id":"p9","title":"","blocks":[{"t":"img","src":"/books/img/0001/10.jpg","alt":""},{"t":"p","x":"Il acheta une bicyclette très haute."}]},{"id":"p10","title":"","blocks":[{"t":"img","src":"/books/img/0001/11.jpg","alt":""},{"t":"p","x":"Il s'assit sur une chaise très haute et mangea avec une très grande fourchette."}]},{"id":"p11","title":"","blocks":[{"t":"img","src":"/books/img/0001/12.jpg","alt":""},{"t":"p","x":"Il quitta sa maison et vécut dans une grande forêt. Il vécut pendant de longues années."}]}]}
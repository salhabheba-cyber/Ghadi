{"v":1,"lang":"en","dir":"ltr","layout":"pages","chapters":[{"id":"cover","title":"Serious accident","blocks":[{"t":"img","src":"/books/img/0285/01.jpg","alt":""},{"t":"h","x":"Serious accident"}]},{"id":"p1","title":"","blocks":[{"t":"img","src":"/books/img/0285/02.jpg","alt":""},{"t":"p","x":"One day my sister and I were walking near the road."}]},{"id":"p2","title":"","blocks":[{"t":"img","src":"/books/img/0285/03.jpg","alt":""},{"t":"p","x":"A big truck was driving down the hill."}]},{"id":"p3","title":"","blocks":[{"t":"img","src":"/books/img/0285/04.jpg","alt":""},{"t":"p","x":"A car was speeding up the hill."}]},{"id":"p4","title":"","blocks":[{"t":"img","src":"/books/img/0285/05.jpg","alt":""},{"t":"p","x":"The truck driver was talking on his cell phone. He was not looking at the road."}]},{"id":"p5","title":"","blocks":[{"t":"img","src":"/books/img/0285/06.jpg","alt":""},{"t":"p","x":"The truck smashed into the car!"}]},{"id":"p6","title":"","blocks":[{"t":"img","src":"/books/img/0285/07.jpg","alt":""},{"t":"p","x":"An ambulance and the police came to help."}]},{"id":"p7","title":"","blocks":[{"t":"img","src":"/books/img/0285/08.jpg","alt":""},{"t":"p","x":"Two tow trucks came. One towed the truck. The other towed the car."}]},{"id":"p8","title":"","blocks":[{"t":"img","src":"/books/img/0285/09.jpg","alt":""},{"t":"p","x":"We saw everything. We were shocked."}]}]}
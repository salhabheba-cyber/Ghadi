{"v":1,"lang":"en","dir":"ltr","layout":"pages","chapters":[{"id":"cover","title":"Tingi and the cows","blocks":[{"t":"img","src":"/books/img/0210/01.jpg","alt":""},{"t":"h","x":"Tingi and the cows"}]},{"id":"p1","title":"","blocks":[{"t":"img","src":"/books/img/0210/02.jpg","alt":""},{"t":"p","x":"Tingi lived with his grandmother."}]},{"id":"p2","title":"","blocks":[{"t":"img","src":"/books/img/0210/03.jpg","alt":""},{"t":"p","x":"He used to look after the cows with her."}]},{"id":"p3","title":"","blocks":[{"t":"img","src":"/books/img/0210/04.jpg","alt":""},{"t":"p","x":"One day the soldiers came."}]},{"id":"p4","title":"","blocks":[{"t":"img","src":"/books/img/0210/05.jpg","alt":""},{"t":"p","x":"They took the cows away."}]},{"id":"p5","title":"","blocks":[{"t":"img","src":"/books/img/0210/06.jpg","alt":""},{"t":"p","x":"Tingi and his grandmother ran away and hid."}]},{"id":"p6","title":"","blocks":[{"t":"img","src":"/books/img/0210/07.jpg","alt":""},{"t":"p","x":"They hid in the bush until night."}]},{"id":"p7","title":"","blocks":[{"t":"img","src":"/books/img/0210/08.jpg","alt":""},{"t":"p","x":"Then the soldiers came back."}]},{"id":"p8","title":"","blocks":[{"t":"img","src":"/books/img/0210/09.jpg","alt":""},{"t":"p","x":"Grandmother hid Tingi under the leaves."}]},{"id":"p9","title":"","blocks":[{"t":"img","src":"/books/img/0210/10.jpg","alt":""},{"t":"p","x":"One of the soldiers put his foot right on him, but he kept quiet."}]},{"id":"p10","title":"","blocks":[{"t":"img","src":"/books/img/0210/11.jpg","alt":""},{"t":"p","x":"When it was safe, Tingi and his grandmother came out."}]},{"id":"p11","title":"","blocks":[{"t":"img","src":"/books/img/0210/12.jpg","alt":""},{"t":"p","x":"They crept home very quietly."}]}]}
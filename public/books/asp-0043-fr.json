{"v":1,"lang":"fr","dir":"ltr","layout":"pages","chapters":[{"id":"cover","title":"L'histoire du feu","blocks":[{"t":"img","src":"/books/img/0043/01.jpg","alt":""},{"t":"h","x":"L'histoire du feu"}]},{"id":"p1","title":"","blocks":[{"t":"img","src":"/books/img/0043/02.jpg","alt":""},{"t":"p","x":"Laisse-moi te raconter mon histoire. Je démarre comme une petite étincelle."}]},{"id":"p2","title":"","blocks":[{"t":"img","src":"/books/img/0043/03.jpg","alt":""},{"t":"p","x":"Je me déchaîne lorsque le vent me porte."}]},{"id":"p3","title":"","blocks":[{"t":"img","src":"/books/img/0043/04.jpg","alt":""},{"t":"p","x":"Toi et moi, nous sommes de bons amis."}]},{"id":"p4","title":"","blocks":[{"t":"img","src":"/books/img/0043/05.jpg","alt":""},{"t":"p","x":"Je cuis ta nourriture."}]},{"id":"p5","title":"","blocks":[{"t":"img","src":"/books/img/0043/06.jpg","alt":""},{"t":"p","x":"J'éclaire tes nuits."}]},{"id":"p6","title":"","blocks":[{"t":"img","src":"/books/img/0043/07.jpg","alt":""},{"t":"p","x":"Je sais faire de nombreuses choses."}]},{"id":"p7","title":"","blocks":[{"t":"img","src":"/books/img/0043/08.jpg","alt":""},{"t":"p","x":"Je fais partie de ta famille."}]},{"id":"p8","title":"","blocks":[{"t":"img","src":"/books/img/0043/09.jpg","alt":""},{"t":"p","x":"Mais prends garde si tu m'invites chez toi. Je n'aime pas qu'on me laisse seul."}]}]}
# Copy to .env and edit. NEVER commit .env (it is git-ignored).

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgres://ghadi@127.0.0.1:5432/ghadi_dev
# Used by `pnpm test`. The name MUST end in _test: the test setup drops and recreates its schema.
TEST_DATABASE_URL=postgres://ghadi@127.0.0.1:5432/ghadi_test

# --- Authentication (Better Auth) ---
# Generate with: openssl rand -base64 32   (required in production)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Local development only ---
# Shows a "Try the demo" button that creates a throwaway parent account. Ignored when NODE_ENV=production.
GHADI_ENABLE_DEMO_ENTRY=true

# --- Teacher provider ---
# Only "demo" (a fixed script, no AI model) is implemented. Any other value falls back to the demo teacher
# and the UI says so. See src/lib/providers/types.ts for the interfaces a real adapter must implement.
LLM_PROVIDER=demo

# Reserved for future adapters. These are NOT read by the code today:
#   LLM_API_KEY, STT_PROVIDER, TTS_PROVIDER, AVATAR_PROVIDER, OCR_PROVIDER

# --- Mobile-number sign-in (one-time codes by SMS) ---
# none (default): mobile sign-in shows "unavailable". console: dev/tests only, prints codes to the server log, refused in production.
# twilio: needs the three values below. Written to Twilio's documented REST API but NOT tested with a real account.
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Transactional email (password reset + email confirmation) ---
# none (default): reset/confirmation are off and the UI says so. console: dev/tests only (refused in production).
# resend: needs RESEND_API_KEY and MAIL_FROM (a verified sender). Written to Resend's documented API; NOT tested with a real account.
MAIL_PROVIDER=none
RESEND_API_KEY=
MAIL_FROM=

# --- Lesson upload OCR ---
# none (default): parents type the text from the page. tesseract: local OCR (needs `tesseract` + language packs; PDFs also need `pdftoppm`).
OCR_PROVIDER=none

# --- AI teacher wording (optional; demo teacher is used when unset) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=replace-me
# ANTHROPIC_MODEL=replace-with-a-model-id-from-your-Anthropic-console

# --- Manual payments (optional) ---
# Shown to parents as "send US$5 by Whish Money to this number". Payments are confirmed by an admin by hand.
# WHISH_NUMBER=replace-with-your-whish-number

# Shown on the privacy and terms pages
# CONTACT_EMAIL=you@example.com

# Set to 1 only after adding public/teacher/idle.mp4, speaking.mp4, listening.mp4
# NEXT_PUBLIC_TEACHER_CLIPS=1

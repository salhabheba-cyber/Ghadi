# Ghadi optional configuration. Every variable here is OPTIONAL.
# Ghadi starts and works fully without any of them (offline mode).
# Copy to .env.local and fill in only what you need. Never commit .env.local.
#
# None of these use the NEXT_PUBLIC_ prefix on purpose: they are server-side only
# and are never bundled into browser code.

# OpenAI (optional, recommended for cloud AI) ---------------------------------
# Your OpenAI API key. PLACEHOLDER ONLY - set the real value in Railway/your host as a private
# server variable. Never commit it, never prefix it with NEXT_PUBLIC_. Usage is billed by OpenAI.
# Required: only to use OpenAI. Server-only.
OPENAI_API_KEY=

# Model used for notes, quizzes, flashcards and answer checks. Default: gpt-4.1-mini.
# Any chat model your account can use works, e.g. gpt-5-mini. Required: no. Server-only.
OPENAI_MODEL=

# Override the API base URL (e.g. a proxy or Azure-compatible gateway). Default: https://api.openai.com/v1
# Required: no. Server-only.
OPENAI_BASE_URL=

# Generic OpenAI-compatible provider (optional, takes precedence when all four are set) -----
# Provider id for the optional hosted AI route. Supported: "openai-compatible".
# Required: no. Configure: server environment only. Client-safe: n/a (server-only).
GHADI_HOSTED_AI_PROVIDER=

# Base URL of an OpenAI-compatible chat completions API (e.g. https://api.example.com/v1).
# Required: only if hosted AI is used. Server-only.
GHADI_HOSTED_AI_BASE_URL=

# API key for the hosted provider. PLACEHOLDER ONLY - never commit a real key.
# Required: only if hosted AI is used. Server-only. NOT safe for client-side use.
GHADI_HOSTED_AI_API_KEY=

# Model name sent to the hosted provider.
# Required: only if hosted AI is used. Server-only.
GHADI_HOSTED_AI_MODEL=

# URL import (optional) -------------------------------------------------------
# Maximum bytes fetched when importing a web article URL. Default: 2000000.
# Required: no. Server-only.
GHADI_URL_IMPORT_MAX_BYTES=

# Request timeout in milliseconds for URL imports. Default: 10000.
# Required: no. Server-only.
GHADI_URL_IMPORT_TIMEOUT_MS=

# Reverse proxy / rate limiting (optional) ------------------------------------
# Set to "true" ONLY when Ghadi runs behind a reverse proxy or platform that sets
# X-Forwarded-For / X-Real-IP itself. When unset, those headers are ignored (they are spoofable)
# and all clients share one rate-limit bucket per instance.
# Required: no. Server-only.
GHADI_TRUST_PROXY=

# Number of trusted proxy hops in front of Ghadi (default 1). The client address is taken as the
# address added by the outermost trusted proxy. Only used when GHADI_TRUST_PROXY=true.
# Required: no. Server-only.
GHADI_TRUSTED_PROXY_HOPS=
